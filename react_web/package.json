{
  "name": "tadreeb-institute-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "start": "electron .",
    "preview": "electron-vite preview",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.tadreeb.institute",
    "productName": "Tadreeb Institute",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@tanstack/react-query": "^5.108.4",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-number-format": "^5.4.5",
    "react-phone-number-input": "^3.4.18",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
